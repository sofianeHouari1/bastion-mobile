package __PKG__

import android.app.NotificationManager
import android.content.Context
import android.content.Intent
import android.os.Bundle
import android.media.AudioDeviceInfo
import android.media.AudioManager
import android.os.Build
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel

class MainActivity : FlutterActivity() {
    // Lien d'un e-mail (https://bastion-secure.group/webrtc-ihm/?ev=...) qui a ouvert l'appli
    private var pendingLink: String? = null
    private var channel: MethodChannel? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        if (intent?.action == Intent.ACTION_VIEW) pendingLink = intent?.dataString
        super.onCreate(savedInstanceState)
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        setIntent(intent)
        val link = if (intent.action == Intent.ACTION_VIEW) intent.dataString else null
        if (link != null) {
            val ch = channel
            if (ch != null) ch.invokeMethod("openLink", link) else pendingLink = link
        }
    }

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        val ch = MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "fr.bastion/native")
        channel = ch
        ch.setMethodCallHandler { call, result ->
            when (call.method) {
                "initialLink" -> { result.success(pendingLink); pendingLink = null }
                "speaker" -> {
                    // Android 12 et plus : isSpeakerphoneOn est ignore pendant un appel WebRTC ;
                    // il faut choisir explicitement le haut-parleur comme peripherique de communication.
                    val on = call.argument<Boolean>("on") ?: false
                    val am = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                    am.mode = AudioManager.MODE_IN_COMMUNICATION
                    var actual = on
                    try {
                        if (Build.VERSION.SDK_INT >= 31) {
                            if (on) {
                                val dev = am.availableCommunicationDevices.firstOrNull { it.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER }
                                actual = dev != null && am.setCommunicationDevice(dev)
                            } else {
                                am.clearCommunicationDevice()
                                actual = false
                            }
                        } else {
                            @Suppress("DEPRECATION")
                            am.isSpeakerphoneOn = on
                            @Suppress("DEPRECATION")
                            actual = am.isSpeakerphoneOn
                        }
                    } catch (e: Exception) { actual = false }
                    result.success(actual)
                }
                "audioReset" -> {
                    val am = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                    try {
                        if (Build.VERSION.SDK_INT >= 31) am.clearCommunicationDevice()
                        @Suppress("DEPRECATION")
                        am.isSpeakerphoneOn = false
                        am.mode = AudioManager.MODE_NORMAL
                    } catch (e: Exception) {}
                    result.success(null)
                }
                "clearNotifications" -> {
                    val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
                    // Efface appels et messages, mais garde la notification fixe du service (id 4242).
                    for (n in nm.activeNotifications) { if (n.id != 4242) nm.cancel(n.tag, n.id) }
                    result.success(null)
                }
                "minimize" -> { moveTaskToBack(true); result.success(null) }
                else -> result.notImplemented()
            }
        }
    }
}
