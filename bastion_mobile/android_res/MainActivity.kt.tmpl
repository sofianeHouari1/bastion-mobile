package __PKG__

import android.app.NotificationManager
import android.content.Context
import android.content.Intent
import android.os.Bundle
import android.media.AudioDeviceInfo
import android.media.AudioManager
import android.os.Build
import android.os.VibrationEffect
import android.os.Vibrator
import android.os.VibratorManager
import android.media.AudioAttributes
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel

class MainActivity : FlutterActivity() {
    // Lien d'un e-mail (https://bastion-secure.group/webrtc-ihm/?ev=...) qui a ouvert l'appli
    private var pendingLink: String? = null
    private var channel: MethodChannel? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        if (intent?.action == Intent.ACTION_VIEW) pendingLink = intent?.dataString
        super.onCreate(savedInstanceState)
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        setIntent(intent)
        val link = if (intent.action == Intent.ACTION_VIEW) intent.dataString else null
        if (link != null) {
            val ch = channel
            if (ch != null) ch.invokeMethod("openLink", link) else pendingLink = link
        }
    }

    private fun setCallDevice(am: AudioManager) {
        if (Build.VERSION.SDK_INT < 31) return
        val devs = am.availableCommunicationDevices
        val pref = listOf(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, AudioDeviceInfo.TYPE_WIRED_HEADSET, AudioDeviceInfo.TYPE_USB_HEADSET,
                          AudioDeviceInfo.TYPE_BLE_HEADSET, AudioDeviceInfo.TYPE_BUILTIN_EARPIECE)
        val dev = pref.firstNotNullOfOrNull { t -> devs.firstOrNull { it.type == t } }
        if (dev != null) am.setCommunicationDevice(dev) else am.clearCommunicationDevice()
    }

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        val ch = MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "fr.bastion/native")
        channel = ch
        ch.setMethodCallHandler { call, result ->
            when (call.method) {
                "initialLink" -> { result.success(pendingLink); pendingLink = null }
                "openExternal" -> {
                    // Mise a jour de l'appli : le telechargement de l'APK s'ouvre dans le navigateur du telephone
                    val u = call.argument<String>("url") ?: ""
                    if (u.startsWith("https://")) {
                        try { startActivity(Intent(Intent.ACTION_VIEW, android.net.Uri.parse(u)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)); result.success(true) }
                        catch (e: Exception) { result.success(false) }
                    } else result.success(false)
                }
                "speaker" -> {
                    // Android 12 et plus : isSpeakerphoneOn est ignore pendant un appel WebRTC ;
                    // il faut choisir explicitement le haut-parleur comme peripherique de communication.
                    val on = call.argument<Boolean>("on") ?: false
                    val am = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                    am.mode = AudioManager.MODE_IN_COMMUNICATION
                    var actual = on
                    try {
                        if (Build.VERSION.SDK_INT >= 31) {
                            if (on) {
                                val dev = am.availableCommunicationDevices.firstOrNull { it.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER }
                                actual = dev != null && am.setCommunicationDevice(dev)
                            } else {
                                // retour explicite à l'écouteur (ou au casque / Bluetooth s'il y en a un), sinon le haut-parleur peut rester actif
                                setCallDevice(am)
                                actual = am.communicationDevice?.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER
                            }
                        } else {
                            @Suppress("DEPRECATION")
                            am.isSpeakerphoneOn = on
                            @Suppress("DEPRECATION")
                            actual = am.isSpeakerphoneOn
                        }
                    } catch (e: Exception) { actual = false }
                    result.success(actual)
                }
                "callAudio" -> {
                    // début d'un appel audio : mode communication, son vers l'écouteur (ou casque / Bluetooth),
                    // et volume d'appel remonté s'il est presque coupé (sinon on n'entend rien sans le haut-parleur)
                    val am = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                    try {
                        am.mode = AudioManager.MODE_IN_COMMUNICATION
                        if (Build.VERSION.SDK_INT >= 31) setCallDevice(am)
                        else { @Suppress("DEPRECATION") am.isSpeakerphoneOn = false }
                        val max = am.getStreamMaxVolume(AudioManager.STREAM_VOICE_CALL)
                        if (am.getStreamVolume(AudioManager.STREAM_VOICE_CALL) < max * 0.4) {
                            am.setStreamVolume(AudioManager.STREAM_VOICE_CALL, (max * 0.6).toInt().coerceAtLeast(1), 0)
                        }
                    } catch (e: Exception) {}
                    result.success(null)
                }
                "vibrate" -> {
                    // Sonnerie d'un appel entrant : vibration répétée, sauf si le téléphone est en mode silencieux
                    val on = (call.arguments as? Boolean) ?: false
                    try {
                        val vib: Vibrator = if (Build.VERSION.SDK_INT >= 31) (getSystemService(Context.VIBRATOR_MANAGER_SERVICE) as VibratorManager).defaultVibrator
                                            else @Suppress("DEPRECATION") (getSystemService(Context.VIBRATOR_SERVICE) as Vibrator)
                        val am = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                        if (on && am.ringerMode != AudioManager.RINGER_MODE_SILENT) {
                            val pattern = longArrayOf(0, 700, 600)
                            val attrs = AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_NOTIFICATION_RINGTONE).setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION).build()
                            if (Build.VERSION.SDK_INT >= 26) vib.vibrate(VibrationEffect.createWaveform(pattern, 0), attrs)
                            else @Suppress("DEPRECATION") vib.vibrate(pattern, 0, attrs)
                        } else vib.cancel()
                        result.success(true)
                    } catch (e: Exception) { result.success(false) }
                }
                "audioReset" -> {
                    val am = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                    try {
                        if (Build.VERSION.SDK_INT >= 31) am.clearCommunicationDevice()
                        @Suppress("DEPRECATION")
                        am.isSpeakerphoneOn = false
                        am.mode = AudioManager.MODE_NORMAL
                    } catch (e: Exception) {}
                    result.success(null)
                }
                "clearNotifications" -> {
                    val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
                    // Efface appels et messages, mais garde la notification fixe du service (id 4242).
                    for (n in nm.activeNotifications) { if (n.id != 4242) nm.cancel(n.tag, n.id) }
                    result.success(null)
                }
                "minimize" -> { moveTaskToBack(true); result.success(null) }
                // Telechargement demande par la page (PDF de compte rendu, fichier d'un dossier...) : confie au
                // gestionnaire de telechargements d'Android, avec la session de l'utilisateur ; arrive dans Telechargements.
                "download" -> {
                    try {
                        val url = call.argument<String>("url")!!
                        val name = (call.argument<String>("name") ?: "document").replace(Regex("[\\\\/:*?\"<>|]"), "_")
                        val mime = call.argument<String>("mime") ?: ""
                        val req = android.app.DownloadManager.Request(android.net.Uri.parse(url))
                        val cookie = call.argument<String>("cookie") ?: ""
                        if (cookie.isNotEmpty()) req.addRequestHeader("Cookie", cookie)
                        val ua = call.argument<String>("ua") ?: ""
                        if (ua.isNotEmpty()) req.addRequestHeader("User-Agent", ua)
                        if (mime.isNotEmpty()) req.setMimeType(mime)
                        req.setTitle(name)
                        req.setNotificationVisibility(android.app.DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED)
                        req.setDestinationInExternalPublicDir(android.os.Environment.DIRECTORY_DOWNLOADS, name)
                        (getSystemService(Context.DOWNLOAD_SERVICE) as android.app.DownloadManager).enqueue(req)
                        result.success(name)
                    } catch (e: Exception) {
                        result.error("download", e.message, null)
                    }
                }
                else -> result.notImplemented()
            }
        }
    }
}
