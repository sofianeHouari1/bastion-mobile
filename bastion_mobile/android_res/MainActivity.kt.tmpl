package __PKG__

import android.app.NotificationManager
import android.content.Context
import android.content.Intent
import android.os.Bundle
import android.media.AudioDeviceInfo
import android.media.AudioManager
import android.os.Build
import android.os.VibrationEffect
import android.os.Vibrator
import android.os.VibratorManager
import android.media.AudioAttributes
import android.app.Notification
import android.app.NotificationChannel
import android.app.Service
import android.content.pm.ServiceInfo
import android.os.IBinder
import android.os.PowerManager
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel

class MainActivity : FlutterActivity() {
    // Lien d'un e-mail (https://bastion-secure.group/webrtc-ihm/?ev=...) qui a ouvert l'appli
    private var pendingLink: String? = null
    private var channel: MethodChannel? = null

    // Fichiers / texte partagés depuis une autre appli (menu « Partager » d'Android)
    private var pendingShare: Intent? = null
    private fun isShare(i: Intent?) = i?.action == Intent.ACTION_SEND || i?.action == Intent.ACTION_SEND_MULTIPLE

    /** Lit les fichiers partagés (15 Mo au total au plus) : nom, type et contenu en base64, pour la page. */
    private fun readShare(i: Intent): Map<String, Any?> {
        val uris = ArrayList<android.net.Uri>()
        try {
            if (i.action == Intent.ACTION_SEND_MULTIPLE) {
                @Suppress("DEPRECATION")
                i.getParcelableArrayListExtra<android.net.Uri>(Intent.EXTRA_STREAM)?.let { uris.addAll(it) }
            } else {
                @Suppress("DEPRECATION")
                (i.getParcelableExtra<android.net.Uri>(Intent.EXTRA_STREAM))?.let { uris.add(it) }
            }
        } catch (e: Exception) {}
        val files = ArrayList<Map<String, Any?>>()
        val skipped = ArrayList<String>()
        var total = 0L
        for (u in uris.take(10)) {
            var name = u.lastPathSegment ?: "fichier"
            try {
                contentResolver.query(u, arrayOf(android.provider.OpenableColumns.DISPLAY_NAME), null, null, null)?.use { c ->
                    if (c.moveToFirst() && !c.isNull(0)) name = c.getString(0)
                }
            } catch (e: Exception) {}
            name = name.substringAfterLast('/')
            try {
                val bytes = contentResolver.openInputStream(u)?.use { inp ->
                    val out = java.io.ByteArrayOutputStream()
                    val buf = ByteArray(65536)
                    var n: Int
                    var over = false
                    while (true) {
                        n = inp.read(buf); if (n < 0) break
                        if (total + out.size() + n > 15L * 1048576) { over = true; break }
                        out.write(buf, 0, n)
                    }
                    if (over) null else out.toByteArray()
                }
                if (bytes == null) { skipped.add(name); continue }
                total += bytes.size
                val type = contentResolver.getType(u) ?: i.type ?: "application/octet-stream"
                files.add(mapOf("name" to name, "type" to type, "b64" to android.util.Base64.encodeToString(bytes, android.util.Base64.NO_WRAP)))
            } catch (e: Exception) { skipped.add(name) }
        }
        return mapOf("text" to (i.getStringExtra(Intent.EXTRA_TEXT) ?: ""), "files" to files, "skipped" to skipped)
    }

    // ---------- Mise à jour de l'appli en un geste (sans Play Store) ----------
    // La page fournit l'adresse de la nouvelle version sur le serveur de l'instance et son empreinte SHA-256 :
    // l'appli télécharge, vérifie, puis confie le fichier à l'installateur d'Android (un seul bouton « Installer »).
    private var pendingInstall: java.io.File? = null
    private val INSTALL_STATUS = "fr.bastion.INSTALL_STATUS"

    private fun downloadUpdate(url: String, sha: String, result: MethodChannel.Result) {
        Thread {
            val r = try {
                val f = java.io.File(cacheDir, "mise-a-jour.apk")
                val c = java.net.URL(url).openConnection() as java.net.HttpURLConnection
                try { android.webkit.CookieManager.getInstance().getCookie(url)?.let { c.setRequestProperty("Cookie", it) } } catch (e: Exception) {}
                c.connectTimeout = 20000; c.readTimeout = 60000
                if (c.responseCode != 200) throw Exception("HTTP " + c.responseCode)
                val md = java.security.MessageDigest.getInstance("SHA-256")
                c.inputStream.use { inp -> f.outputStream().use { out ->
                    val b = ByteArray(65536)
                    while (true) { val n = inp.read(b); if (n < 0) break; md.update(b, 0, n); out.write(b, 0, n) }
                } }
                val hex = md.digest().joinToString("") { "%02x".format(it) }
                if (sha.isNotEmpty() && hex != sha.lowercase()) { f.delete(); throw Exception("empreinte") }
                f
            } catch (e: Exception) { null }
            runOnUiThread {
                if (r == null) { result.success("erreur"); return@runOnUiThread }
                if (Build.VERSION.SDK_INT >= 26 && !packageManager.canRequestPackageInstalls()) {
                    // première fois : Android demande d'autoriser cette appli à installer ses mises à jour
                    pendingInstall = r
                    try { startActivity(Intent(android.provider.Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, android.net.Uri.parse("package:" + packageName))) } catch (e: Exception) {}
                    result.success("autoriser")
                } else result.success(if (installApk(r)) "ok" else "erreur")
            }
        }.start()
    }

    private fun installApk(f: java.io.File): Boolean = try {
        val pi = packageManager.packageInstaller
        val id = pi.createSession(android.content.pm.PackageInstaller.SessionParams(android.content.pm.PackageInstaller.SessionParams.MODE_FULL_INSTALL))
        pi.openSession(id).use { s ->
            s.openWrite("app.apk", 0, f.length()).use { o -> f.inputStream().use { it.copyTo(o) }; s.fsync(o) }
            val i = Intent(this, MainActivity::class.java).setAction(INSTALL_STATUS)
            val fl = if (Build.VERSION.SDK_INT >= 31) android.app.PendingIntent.FLAG_MUTABLE or android.app.PendingIntent.FLAG_UPDATE_CURRENT
                     else android.app.PendingIntent.FLAG_UPDATE_CURRENT
            s.commit(android.app.PendingIntent.getActivity(this, 7301, i, fl).intentSender)
        }
        true
    } catch (e: Exception) { false }

    private fun installStatus(i: Intent?) {
        if (i?.action != INSTALL_STATUS) return
        if (i.getIntExtra(android.content.pm.PackageInstaller.EXTRA_STATUS, -999) == android.content.pm.PackageInstaller.STATUS_PENDING_USER_ACTION) {
            @Suppress("DEPRECATION")
            val confirm = i.getParcelableExtra<Intent>(Intent.EXTRA_INTENT)
            if (confirm != null) try { startActivity(confirm.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)) } catch (e: Exception) {}
        }
    }

    override fun onResume() {
        super.onResume()
        val f = pendingInstall
        if (f != null && (Build.VERSION.SDK_INT < 26 || packageManager.canRequestPackageInstalls())) { pendingInstall = null; installApk(f) }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        installStatus(intent)
        if (intent?.action == Intent.ACTION_VIEW) pendingLink = intent?.dataString
        if (isShare(intent)) pendingShare = intent
        super.onCreate(savedInstanceState)
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        setIntent(intent)
        installStatus(intent)
        if (isShare(intent)) { pendingShare = intent; channel?.invokeMethod("share", null) }
        val link = if (intent.action == Intent.ACTION_VIEW) intent.dataString else null
        if (link != null) {
            val ch = channel
            if (ch != null) ch.invokeMethod("openLink", link) else pendingLink = link
        }
    }

    private fun setCallDevice(am: AudioManager) {
        if (Build.VERSION.SDK_INT < 31) return
        val devs = am.availableCommunicationDevices
        val pref = listOf(AudioDeviceInfo.TYPE_BLUETOOTH_SCO, AudioDeviceInfo.TYPE_WIRED_HEADSET, AudioDeviceInfo.TYPE_USB_HEADSET,
                          AudioDeviceInfo.TYPE_BLE_HEADSET, AudioDeviceInfo.TYPE_BUILTIN_EARPIECE)
        val dev = pref.firstNotNullOfOrNull { t -> devs.firstOrNull { it.type == t } }
        if (dev != null) am.setCommunicationDevice(dev) else am.clearCommunicationDevice()
    }

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)
        val ch = MethodChannel(flutterEngine.dartExecutor.binaryMessenger, "fr.bastion/native")
        channel = ch
        ch.setMethodCallHandler { call, result ->
            when (call.method) {
                "initialLink" -> { result.success(pendingLink); pendingLink = null }
                "installUpdate" -> {
                    val url = call.argument<String>("url") ?: ""
                    if (!url.startsWith("https://")) result.success("erreur") else downloadUpdate(url, call.argument<String>("sha") ?: "", result)
                }
                "takeShare" -> {
                    val i = pendingShare
                    pendingShare = null
                    if (i == null) result.success(null)
                    else Thread {
                        val m = try { readShare(i) } catch (e: Exception) { null }
                        runOnUiThread { result.success(m) }
                    }.start()
                }
                "openExternal" -> {
                    // Mise a jour de l'appli : le telechargement de l'APK s'ouvre dans le navigateur du telephone
                    val u = call.argument<String>("url") ?: ""
                    if (u.startsWith("https://")) {
                        try { startActivity(Intent(Intent.ACTION_VIEW, android.net.Uri.parse(u)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)); result.success(true) }
                        catch (e: Exception) { result.success(false) }
                    } else result.success(false)
                }
                "speaker" -> {
                    // Android 12 et plus : isSpeakerphoneOn est ignore pendant un appel WebRTC ;
                    // il faut choisir explicitement le haut-parleur comme peripherique de communication.
                    val on = call.argument<Boolean>("on") ?: false
                    val am = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                    am.mode = AudioManager.MODE_IN_COMMUNICATION
                    var actual = on
                    try {
                        if (Build.VERSION.SDK_INT >= 31) {
                            if (on) {
                                val dev = am.availableCommunicationDevices.firstOrNull { it.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER }
                                actual = dev != null && am.setCommunicationDevice(dev)
                            } else {
                                // retour explicite à l'écouteur (ou au casque / Bluetooth s'il y en a un), sinon le haut-parleur peut rester actif
                                setCallDevice(am)
                                actual = am.communicationDevice?.type == AudioDeviceInfo.TYPE_BUILTIN_SPEAKER
                            }
                        } else {
                            @Suppress("DEPRECATION")
                            am.isSpeakerphoneOn = on
                            @Suppress("DEPRECATION")
                            actual = am.isSpeakerphoneOn
                        }
                    } catch (e: Exception) { actual = false }
                    result.success(actual)
                }
                "callAudio" -> {
                    // début d'un appel audio : mode communication, son vers l'écouteur (ou casque / Bluetooth),
                    // et volume d'appel remonté s'il est presque coupé (sinon on n'entend rien sans le haut-parleur)
                    val am = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                    try {
                        am.mode = AudioManager.MODE_IN_COMMUNICATION
                        if (Build.VERSION.SDK_INT >= 31) setCallDevice(am)
                        else { @Suppress("DEPRECATION") am.isSpeakerphoneOn = false }
                        val max = am.getStreamMaxVolume(AudioManager.STREAM_VOICE_CALL)
                        if (am.getStreamVolume(AudioManager.STREAM_VOICE_CALL) < max * 0.4) {
                            am.setStreamVolume(AudioManager.STREAM_VOICE_CALL, (max * 0.6).toInt().coerceAtLeast(1), 0)
                        }
                    } catch (e: Exception) {}
                    result.success(null)
                }
                // Appel ou visio en cours : service « micro » au premier plan + maintien du processeur, pour que le micro
                // continue de capter quand l'écran se verrouille (sinon Android coupe le micro au bout de quelques secondes).
                "callActive" -> {
                    val on = (call.arguments as? Boolean) ?: false
                    try {
                        val svc = Intent(this, CallService::class.java)
                        if (on) { if (Build.VERSION.SDK_INT >= 26) startForegroundService(svc) else startService(svc) } else stopService(svc)
                        result.success(true)
                    } catch (e: Exception) { result.success(false) }
                }
                "vibrate" -> {
                    // Sonnerie d'un appel entrant : vibration répétée, sauf si le téléphone est en mode silencieux
                    val on = (call.arguments as? Boolean) ?: false
                    try {
                        val vib: Vibrator = if (Build.VERSION.SDK_INT >= 31) (getSystemService(Context.VIBRATOR_MANAGER_SERVICE) as VibratorManager).defaultVibrator
                                            else @Suppress("DEPRECATION") (getSystemService(Context.VIBRATOR_SERVICE) as Vibrator)
                        val am = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                        if (on && am.ringerMode != AudioManager.RINGER_MODE_SILENT) {
                            val pattern = longArrayOf(0, 700, 600)
                            val attrs = AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_NOTIFICATION_RINGTONE).setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION).build()
                            if (Build.VERSION.SDK_INT >= 26) vib.vibrate(VibrationEffect.createWaveform(pattern, 0), attrs)
                            else @Suppress("DEPRECATION") vib.vibrate(pattern, 0, attrs)
                        } else vib.cancel()
                        result.success(true)
                    } catch (e: Exception) { result.success(false) }
                }
                "audioReset" -> {
                    val am = getSystemService(Context.AUDIO_SERVICE) as AudioManager
                    try {
                        if (Build.VERSION.SDK_INT >= 31) am.clearCommunicationDevice()
                        @Suppress("DEPRECATION")
                        am.isSpeakerphoneOn = false
                        am.mode = AudioManager.MODE_NORMAL
                    } catch (e: Exception) {}
                    result.success(null)
                }
                "clearNotifications" -> {
                    val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
                    // Efface appels et messages, mais garde la notification fixe du service (id 4242).
                    for (n in nm.activeNotifications) { if (n.id != 4242) nm.cancel(n.tag, n.id) }
                    result.success(null)
                }
                "minimize" -> { moveTaskToBack(true); result.success(null) }
                // Telechargement demande par la page (PDF de compte rendu, fichier d'un dossier...) : confie au
                // gestionnaire de telechargements d'Android, avec la session de l'utilisateur ; arrive dans Telechargements.
                "download" -> {
                    try {
                        val url = call.argument<String>("url")!!
                        val name = (call.argument<String>("name") ?: "document").replace(Regex("[\\\\/:*?\"<>|]"), "_")
                        val mime = call.argument<String>("mime") ?: ""
                        val req = android.app.DownloadManager.Request(android.net.Uri.parse(url))
                        val cookie = call.argument<String>("cookie") ?: ""
                        if (cookie.isNotEmpty()) req.addRequestHeader("Cookie", cookie)
                        val ua = call.argument<String>("ua") ?: ""
                        if (ua.isNotEmpty()) req.addRequestHeader("User-Agent", ua)
                        if (mime.isNotEmpty()) req.setMimeType(mime)
                        req.setTitle(name)
                        req.setNotificationVisibility(android.app.DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED)
                        req.setDestinationInExternalPublicDir(android.os.Environment.DIRECTORY_DOWNLOADS, name)
                        (getSystemService(Context.DOWNLOAD_SERVICE) as android.app.DownloadManager).enqueue(req)
                        result.success(name)
                    } catch (e: Exception) {
                        result.error("download", e.message, null)
                    }
                }
                else -> result.notImplemented()
            }
        }
    }
}


/** Service de premier plan pendant un appel : autorise le micro écran verrouillé et garde le processeur éveillé. */
class CallService : Service() {
    private var lock: PowerManager.WakeLock? = null

    override fun onBind(intent: Intent?): IBinder? = null

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        if (Build.VERSION.SDK_INT >= 26 && nm.getNotificationChannel("call_ongoing") == null) {
            nm.createNotificationChannel(NotificationChannel("call_ongoing", "Appel en cours", NotificationManager.IMPORTANCE_LOW))
        }
        val open = packageManager.getLaunchIntentForPackage(packageName)
        val pi = android.app.PendingIntent.getActivity(this, 7, open, android.app.PendingIntent.FLAG_IMMUTABLE or android.app.PendingIntent.FLAG_UPDATE_CURRENT)
        val b = if (Build.VERSION.SDK_INT >= 26) Notification.Builder(this, "call_ongoing") else @Suppress("DEPRECATION") Notification.Builder(this)
        val icon = resources.getIdentifier("ic_stat_bastion", "drawable", packageName).let { if (it != 0) it else applicationInfo.icon }
        val n = b.setContentTitle("Appel en cours").setContentText("Touchez pour revenir à l'appel").setSmallIcon(icon)
            .setOngoing(true).setContentIntent(pi).build()
        try {
            if (Build.VERSION.SDK_INT >= 30) startForeground(4343, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE)
            else startForeground(4343, n)
        } catch (e: Exception) { stopSelf(); return START_NOT_STICKY }
        if (lock == null) {
            lock = (getSystemService(Context.POWER_SERVICE) as PowerManager).newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "bastion:call").apply {
                setReferenceCounted(false); acquire(4 * 60 * 60 * 1000L)
            }
        }
        return START_NOT_STICKY
    }

    override fun onDestroy() {
        try { lock?.release() } catch (e: Exception) {}
        lock = null
        super.onDestroy()
    }
}
